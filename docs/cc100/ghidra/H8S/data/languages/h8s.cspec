<?xml version="1.0" encoding="UTF-8"?>
<!-- Renesas H8S C compiler: args ER0, ER1, then stack; result ER0; ER2-ER6 callee-saved -->
<compiler_spec>
	<data_organization>
		<default_alignment value="2" />
		<machine_alignment value="2" />
		<pointer_size value="4" />
		<integer_size value="2" />
		<short_size value="2" />
		<long_size value="4" />
		<size_alignment_map>
			<entry size="1" alignment="1" />
			<entry size="2" alignment="2" />
			<entry size="4" alignment="2" />
			<entry size="8" alignment="2" />
		</size_alignment_map>
	</data_organization>
	<global>
		<range space="ram" />
	</global>
	<stackpointer register="sp" space="ram" />
	<returnaddress>
		<varnode space="stack" offset="0" size="4" />
	</returnaddress>
	<default_proto>
		<prototype name="__stdcall" extrapop="4" stackshift="4">
			<input>
				<pentry minsize="1" maxsize="4"><register name="er0" /></pentry>
				<pentry minsize="1" maxsize="4"><register name="er1" /></pentry>
				<pentry minsize="1" maxsize="500" align="2"><addr offset="4" space="stack" /></pentry>
			</input>
			<output>
				<pentry minsize="1" maxsize="4"><register name="er0" /></pentry>
			</output>
			<killedbycall>
				<register name="er0" />
				<register name="er1" />
			</killedbycall>
			<unaffected>
				<register name="er2" />
				<register name="er3" />
				<register name="er4" />
				<register name="er5" />
				<register name="er6" />
				<register name="sp" />
			</unaffected>
		</prototype>
	</default_proto>
</compiler_spec>
